# Local demo environment for the marketing app (copy to .env.local; never commit).
# .env.local is gitignored. See .env.example for the full production variable list.

# Neon branch connection string (postgresql://user:password@host/db?sslmode=require).
# Apply schema first:
#   node scripts/demo/run-sql.mjs scripts/add-foundation-columns.sql --env .env.local
#   node scripts/demo/run-sql.mjs scripts/add-setup-fee-columns.sql --env .env.local
#   node scripts/demo/run-sql.mjs /Users/marcel/nexli-portal/scripts/add-foundation-tier.sql --env /Users/marcel/nexli-portal/.env.local
#   node scripts/demo/run-sql.mjs /Users/marcel/nexli-portal/scripts/add-firm-sites.sql --env /Users/marcel/nexli-portal/.env.local
DATABASE_URL=

# Stripe TEST mode secret key (never a live key here).
STRIPE_SECRET_KEY=sk_test_...

# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_...

# Recurring $497/mo test Price. Create it with:
#   node scripts/demo/create-stripe-test-product.mjs --env .env.local
STRIPE_FOUNDATION_PRICE_ID=

# One-time $999 setup-fee test Price, charged alongside the subscription on
# the /demo/offer checkout. Printed by the same script as above.
STRIPE_FOUNDATION_SETUP_PRICE_ID=

# Dev only: skips Stripe's Terms-of-Service consent on the checkout page.
# Stripe rejects consent_collection until a ToS URL is set under the account's
# public business details. Remove this line in production after setting that URL.
STRIPE_SKIP_TOS_CONSENT=1

# Origin of this app; used for Stripe success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the dashboard app (portal provisioning calls go here).
DASHBOARD_INTERNAL_URL=http://localhost:3001

# Any long random string (openssl rand -hex 32). Must match dashboard/.env.local.
PROVISION_SECRET=

# Anthropic API key. Optional for the demo funnel (the /demo sandbox shows one
# fixed firm, no generated copy). Still used by the firm-site generator in
# lib/firm-sites/generator.ts when an admin builds a real firm's website.
ANTHROPIC_API_KEY=

# Required by the demo funnel: signs the cookie that carries the lead id from
# /demo-opt-in through /demo/qualify to checkout. Generate with:
#   openssl rand -hex 32
DEMO_SESSION_SECRET=

# GoHighLevel. GHL_API_KEY must be a PRIVATE INTEGRATION token (starts
# "pit-"), not a classic v1 API key — the v2 API rejects the latter with 401.
# Create it at Settings > Private Integrations with write scopes for contacts,
# tags and notes. GHL_LOCATION_ID is the sub-account id from Settings >
# Business Profile, or the <id> in https://app.gohighlevel.com/v2/location/<id>/...
GHL_API_KEY=
GHL_LOCATION_ID=

# Optional. Compact JSON printed by:
#   node scripts/ghl/setup-custom-fields.mjs --env .env.local
# Without it lib/ghl.ts sends field keys instead of ids and still writes a
# note with every answer, so this is an optimisation rather than a requirement.
GHL_CUSTOM_FIELD_IDS=

# Optional GHL inbound webhooks for the demo funnel. Each one fires a
# workflow; the contact record itself is written directly by lib/ghl.ts.
GHL_DEMO_OPTIN_WEBHOOK_URL=      # /demo-opt-in submitted (name, email, phone, firm) — tag "demo opt-in"
GHL_DEMO_QUALIFY_WEBHOOK_URL=    # six questions answered — carries the answers and the agency/web split
GHL_DEMO_BOOKING_WEBHOOK_URL=    # a qualified firm booked on /demo/call

# Optional. Comma-separated hosts that should NEVER be treated as a firm's
# custom domain by middleware.ts (nexli.net, *.vercel.app, localhost and IP
# literals are already excluded). Example: staging.example.com,demo.local
NEXT_PUBLIC_OWN_HOSTS=
