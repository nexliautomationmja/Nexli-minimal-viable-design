# Database (Neon / Vercel Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# NextAuth
NEXTAUTH_URL=http://localhost:3000  # Production: https://portal.nexli.net
NEXTAUTH_SECRET=  # Generate with: openssl rand -base64 32

# Admin seeding
ADMIN_INITIAL_PASSWORD=  # Strong password for mail@nexli.net

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel Analytics API
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=team_Gmt8LmYuSCUbxbFGNfUAfyyA

# GoHighLevel
# Must be a PRIVATE INTEGRATION token (starts "pit-"), not a classic v1 API
# key (the long "eyJ..." JWT) — services.leadconnectorhq.com rejects the
# latter with 401. Create it at Settings > Private Integrations and give it
# write scopes for contacts, tags and notes (plus locations/customFields
# read+write if you want to run scripts/ghl/setup-custom-fields.mjs).
GHL_API_KEY=
# The sub-account id. Settings > Business Profile > "Location ID", or the
# <id> in any GHL app URL: https://app.gohighlevel.com/v2/location/<id>/...
GHL_LOCATION_ID=
# Optional. Compact JSON printed by:
#   node scripts/ghl/setup-custom-fields.mjs --env .env.local
# Maps nexli_* field keys to GHL custom-field ids. Without it lib/ghl.ts
# falls back to sending field keys and always writes a note with every
# answer, so the script is an optimisation, not a requirement.
GHL_CUSTOM_FIELD_IDS=

# Supabase (Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Portal URL (for generating secure upload links)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000  # Production: https://portal.nexli.net

# Resend (Email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Nexli Portal <documents@nexli.net>

# Anthropic (AI Insights)
ANTHROPIC_API_KEY=

# Meta Pixel & Conversions API
NEXT_PUBLIC_META_PIXEL_ID=910151701422761
META_CAPI_ACCESS_TOKEN=          # Generate in Events Manager > Settings > Conversions API
META_API_VERSION=v21.0
META_TEST_EVENT_CODE=            # Set for test mode (e.g. TEST12345), remove for production

# CRM Webhook Security (for GHL lifecycle webhooks)
CRM_WEBHOOK_SECRET=              # Shared secret — generate with: openssl rand -hex 32

# GHL Webhooks (moved from hardcoded URLs)
GHL_AUDIT_WEBHOOK_URL=
GHL_GUIDE_WEBHOOK_URL=
GHL_QUALIFICATION_WEBHOOK_URL=
GHL_REVENUE_CALC_WEBHOOK_URL=

# Book of Business Accelerator — $97 one-time low-ticket funnel
# (/advisory-pricing -> /qualify -> /call (qualified) | /BOBA -> Stripe -> /BOBA-thank-you (not a fit))
# Replaced the retired $97 CPA Scaling Roadmap.
# The PDF itself is NOT an env var: it lives at assets/book-of-business-accelerator.pdf
# and is served by the gated /api/advisory-pricing/download route.
STRIPE_ADVISORY_PRICE_ID=                 # REQUIRED: one-time $97 Price id (price_...). No fallback by design — a missing value throws rather than silently charging a Product's default price.
NEXT_PUBLIC_SITE_URL=https://www.nexli.net  # http://localhost:3000 in dev — used for Stripe success/cancel URLs
GHL_ADVISORY_OPTIN_WEBHOOK_URL=           # Optional: fires on opt-in — tag "advisory opt-in", start the pre-purchase nurture
GHL_ADVISORY_PURCHASE_WEBHOOK_URL=        # Delivers the download link by email. Without it the buyer pays and receives nothing — logged as an error, not a warning.
GHL_ADVISORY_CHECKOUT_WEBHOOK_URL=        # Optional: abandoned-checkout workflow
GHL_ADVISORY_QUALIFY_WEBHOOK_URL=         # REQUIRED: fires after the qualifier; carries `qualified`, `budget` and a signed `resume_url`
GHL_ADVISORY_BOOKING_WEBHOOK_URL=         # REQUIRED: booking confirmations and reminders. Keys off `booking_start`

# Firm Foundation ($497/mo website + client portal subscription)
STRIPE_FOUNDATION_PRICE_ID=               # Required for checkout: recurring monthly Price id (price_...) for the Firm Foundation product
STRIPE_FOUNDATION_SETUP_PRICE_ID=         # Required for checkout: one-time $999 setup-fee Price id (price_...) on the same product
GHL_FOUNDATION_CHECKOUT_WEBHOOK_URL=      # Optional: abandoned-checkout workflow (fires when "Subscribe" is clicked on the preview page)
GHL_FOUNDATION_PURCHASE_WEBHOOK_URL=      # GHL inbound webhook: tag foundation-customer, start onboarding sequence
GHL_FOUNDATION_BOOKING_WEBHOOK_URL=       # Optional: kickoff-call booking; falls back to GHL_QUALIFICATION_WEBHOOK_URL
# ANTHROPIC_API_KEY (above) is also used here: Claude writes the copy for the "see your new website" preview; without it the preview falls back to template copy.
DASHBOARD_INTERNAL_URL=                   # Origin of the dashboard app, e.g. https://portal.nexli.net — provisions portal accounts
PROVISION_SECRET=                         # Shared secret sent as x-provision-secret to the dashboard's /api/internal/* routes — generate with: openssl rand -hex 32

# Demo funnel (/demo-opt-in -> /demo -> /demo/qualify -> /demo/call | /demo/offer)
DEMO_SESSION_SECRET=                      # Required: signs the demo funnel's lead cookie — generate with: openssl rand -hex 32
GHL_DEMO_OPTIN_WEBHOOK_URL=               # Optional: fires on /demo-opt-in (name, email, phone, firm) — tag "demo opt-in", start the nurture
GHL_DEMO_QUALIFY_WEBHOOK_URL=             # Optional: fires after the six questions with the answers and the agency/web split
GHL_DEMO_BOOKING_WEBHOOK_URL=             # Optional: fires when a qualified firm books on /demo/call; falls back to GHL_QUALIFICATION_WEBHOOK_URL

# Search engine ownership verification (AI search visibility)
NEXT_PUBLIC_GSC_VERIFICATION=             # Google Search Console > Settings > Ownership verification > HTML tag (content value only)
NEXT_PUBLIC_BING_VERIFICATION=            # Bing Webmaster Tools > Settings > Verify ownership > HTML meta tag (content value only). ChatGPT search uses Bing's index.
